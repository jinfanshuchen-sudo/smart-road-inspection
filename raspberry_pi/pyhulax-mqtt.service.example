[Unit]
Description=Pyhulax Offline MQTT Broker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__PYHULAX_USER__
WorkingDirectory=__PYHULAX_DIR__
Environment=PYTHONUNBUFFERED=1
ExecStart=__PYHULAX_DIR__/.venv/bin/python __PYHULAX_DIR__/offline_mqtt_broker.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
